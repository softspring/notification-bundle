{
    "name": "softspring/notification-bundle",
    "description": "User notifications bundle",
    "type": "symfony-bundle",
    "license": "AGPL-3.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/orm": "^2.10 | ^3.0",
        "softspring/user-bundle": "^6.0@dev",
        "symfony/console": "^6.4|^7.4|^8.0",
        "symfony/form": "^6.4|^7.4|^8.0",
        "symfony/framework-bundle": "^6.4|^7.4|^8.0",
        "symfony/security-bundle": "^6.4|^7.4|^8.0",
        "symfony/translation": "^6.4|^7.4|^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.89",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Softspring\\NotificationBundle\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
